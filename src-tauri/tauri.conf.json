{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wodeo",
  "version": "0.1.0",
  "identifier": "com.wochap.wodeo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "wodeo",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
